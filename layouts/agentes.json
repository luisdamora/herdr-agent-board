{
  "id": "root",
  "type": "row",
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": {
        "px": 250
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false,
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "workspace-chrome"
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "spaces",
          "type": "block",
          "content": {
            "mod": "spaces"
          },
          "size": {
            "weight": 1
          },
          "min": 90
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "workspace-chrome",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 69
          }
        }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "resizable": false,
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "tabs"
          },
          "size": {
            "px": 42
          },
          "window_drag": true
        },
        {
          "id": "work-body",
          "type": "row",
          "padding": 8,
          "gap": 8,
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "pane"
                    },
                    "reveal": "always",
                    "height": 30,
                    "position": "top"
                  },
                  "background": "background",
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "radius": 10,
                  "gap": 8,
                  "lone": true
                }
              }
            },
            {
              "id": "board",
              "type": "column",
              "hidden": false,
              "size": {
                "px": 360
              },
              "min": 48,
              "max": 600,
              "background": "surface",
              "border": {
                "width": 1,
                "color": "border"
              },
              "radius": 10,
              "children": [
                {
                  "id": "activity-board",
                  "type": "block",
                  "content": {
                    "mod": "tablero-agentes"
                  }
                }
              ]
            },
            {
              "id": "panel",
              "type": "column",
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "hidden": true,
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "active": "files",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "status-row",
          "type": "row",
          "size": {
            "px": 28
          },
          "children": [
            {
              "id": "status",
              "type": "block",
              "content": {
                "mod": "workspace-status"
              },
              "size": {
                "weight": 1
              }
            },
            {
              "id": "active-agents",
              "type": "block",
              "content": {
                "mod": "tira-agentes"
              },
              "size": {
                "px": 440
              },
              "min": 220,
              "window_drag": true
            },
            {
              "id": "dictar",
              "type": "block",
              "content": {
                "mod": "mi-boton"
              },
              "size": {
                "px": 168
              }
            }
          ]
        }
      ]
    }
  ]
}
